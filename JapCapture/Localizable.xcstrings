    "personal.sourcesAndLicenses.body" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This app uses JMdict dictionary data from the Electronic Dictionary Research and Development Group (EDRDG). JMdict is licensed under Creative Commons Attribution-ShareAlike 4.0 International.\n\nCopyright (c) James William Breen and The Electronic Dictionary Research and Development Group.\n\nThis app uses the google/siglip-base-patch16-224 SigLIP model by Google for on-device image-label matching. The bundled Core ML model and generated text embeddings are derived from that model.\n\nSigLIP is licensed under the Apache License 2.0."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本应用使用 Electronic Dictionary Research and Development Group (EDRDG) 提供的 JMdict 词典数据。JMdict 采用 Creative Commons Attribution-ShareAlike 4.0 International 许可。\n\nCopyright (c) James William Breen and The Electronic Dictionary Research and Development Group.\n\n本应用使用 Google 的 google/siglip-base-patch16-224 SigLIP 模型进行设备端图像标签匹配。随应用提供的 Core ML 模型和生成的文本嵌入数据均源自该模型。\n\nSigLIP 采用 Apache License 2.0 许可。"
          }
        }
      }
    },
